# API Keys and Environment
.env
.env.*
!.env.example

# Python caches
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual Environments
venv/
env/
.venv/

# IDE files
.vscode/
.idea/

# Generated artifacts (regenerated by the loaders / first experiment run)
data/*.index
data/*.index_map.json
data/squad_subset.json
data/hotpot_subset.json
data/hotpot_corpus.json
data/cache/

# Raw dataset downloads (HotpotQA dev is ~45 MB; squad_dev.json is already tracked)
data/hotpot_dev_distractor.json

# results/ IS tracked on purpose — the JSON summaries are the evidence behind the
# paper and must be reviewable. Only scratch output is ignored.
tmp/

# Dry-run output is synthetic; it must never be mistaken for evidence.
results_dryrun/

# LaTeX build artifacts. paper/generated/ IS tracked: it is the audit trail
# linking each number in the PDF back to a results file.
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.pdf

# Human annotations ARE tracked — they are the evidence for the agreement stats.

# Transient run logs
run.log
*.log

# Intermediate per-condition checkpoints; final results/*.json supersede them
results/checkpoints/
overleaf_upload.zip
