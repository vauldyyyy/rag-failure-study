# Copy to .env and fill in. Get a free key at https://aistudio.google.com
GEMINI_API_KEY=your_key_here

# Optional: use a different model as the faithfulness judge. Leaving this unset
# means the judge and the generator are the same checkpoint, which is
# self-evaluation — every results file records this as judge_self_eval: true.
# JUDGE_MODEL=models/gemini-2.5-pro
