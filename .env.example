# Required for --gen gemini / --embed gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional overrides
# RAG_GEN_MODEL=gemini-2.5-flash
# RAG_JUDGE_MODEL=gemini-2.5-flash
# RAG_EMBED_MODEL=gemini-embedding-001
# RAG_EMBED_DIM=768
# RAG_THINKING_BUDGET=0        # -1 leaves the model default (required for 2.5 Pro)
# RAG_RPM=10                   # client-side throttle; match your tier's requests/minute

# Optional second model through any OpenAI-compatible API (--gen openai), e.g. Groq
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=llama-3.3-70b-versatile
