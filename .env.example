# Copy to .env and fill in. Get a free key at https://aistudio.google.com
GEMINI_API_KEY=your_key_here

# Optional: use a different model as the faithfulness judge. Leaving this unset
# means the judge and the generator are the same checkpoint, which is
# self-evaluation — every results file records this as judge_self_eval: true.
# JUDGE_MODEL=models/gemini-2.5-pro

# Retrieval backend. "local" (default) runs sentence-transformers on CPU: no API,
# no quota, and reproducible by anyone without a key. "gemini" uses
# gemini-embedding-001 (3072-d) but 1,330 chunks exceeds the free-tier DAILY
# embedding cap, so the index cannot be built in a single day.
# EMBED_BACKEND=local
# LOCAL_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Client-side rate limits (requests/minute). Raise these on a paid key.
# EMBED_RPM=95
# LLM_RPM=9
